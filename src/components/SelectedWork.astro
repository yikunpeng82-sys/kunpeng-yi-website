---
import type { Copy } from "../data/i18n";
import { selectedPublications, doiUrl, isYi, displayAuthor } from "../data/publications";
import { withBase } from "../lib/paths";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const items = selectedPublications().slice(0, 5);
---

<section class="section band-sand" id={copy.selected.id} aria-labelledby="selected-title">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker" style="color: var(--wetland)">{copy.selected.kicker}</p>
      <h2 id="selected-title">{copy.selected.title}</h2>
      <p>{copy.selected.intro}</p>
    </div>
    <ol class="cite-list">
      {
        items.map((paper) => (
          <li class="cite-item">
            <p class="cite">
              {paper.authors.map((name, i) => (
                <>
                  {i > 0 ? ", " : ""}
                  {isYi(name) ? <strong>{displayAuthor(name, copy.lang)}</strong> : displayAuthor(name, copy.lang)}
                </>
              ))}
              {" "}({paper.year}). {paper.title}. <em>{paper.journal}</em>
              {paper.volume ? ` ${paper.volume}` : ""}
              {paper.issue ? `(${paper.issue})` : ""}
              {paper.pages ? `: ${paper.pages}` : ""}.
            </p>
            {
              paper.doi ? (
                <p class="doi-line">
                  <a href={doiUrl(paper.doi)} target="_blank" rel="noopener noreferrer">
                    {copy.selected.read}: {paper.doi}
                  </a>
                </p>
              ) : null
            }
          </li>
        ))
      }
    </ol>
    <p style="margin: 1.5rem 0 0">
      <a class="btn btn-primary" href={withBase(copy.publicationsHref)} style="background: var(--navy); color: var(--paper)">
        {copy.selected.more}
      </a>
    </p>
  </div>
</section>
