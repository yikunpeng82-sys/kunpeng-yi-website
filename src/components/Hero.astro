---
import type { Copy } from "../data/i18n";
import { SITE } from "../data/site";
import { withBase } from "../lib/paths";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="hero" aria-labelledby="hero-name">
  <div class="wrap hero-grid">
    <div>
      <p class="kicker">{copy.hero.kicker}</p>
      <div class="hero-identity">
        <img
          class="hero-portrait"
          src={withBase(SITE.portrait)}
          alt={SITE.photoAlt}
          width="160"
          height="160"
          fetchpriority="high"
          decoding="async"
        />
        <div>
          <h1 id="hero-name">{copy.hero.name}</h1>
          <p class="hero-alt">{copy.hero.nameAlt}</p>
        </div>
      </div>
      <p class="hero-role">{copy.hero.role}</p>
      <p class="hero-aff">{copy.hero.affiliation}</p>
      <p class="hero-lab">
        <a href={SITE.labUrl} rel="noopener noreferrer">{copy.hero.lab}</a>
      </p>
      <p class="hero-line">{copy.hero.line}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={SITE.scholarUrl} rel="noopener noreferrer">{copy.hero.scholar}</a>
        <a class="btn btn-orange" href={withBase(copy.lang === "zh" ? SITE.cvZh : SITE.cvEn)} download>
          {copy.hero.cv}
        </a>
        <a class="btn btn-ghost" href={withBase(`${copy.homeHref}#contact`)}>{copy.hero.contact}</a>
      </div>
    </div>
    <aside class="facts-card" aria-label={copy.lang === "zh" ? "数字概览" : "At a glance"}>
      <ul class="facts">
        {
          copy.hero.facts.map((fact) => (
            <li>
              <strong>{fact.value}</strong>
              <span>{fact.label}</span>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>
