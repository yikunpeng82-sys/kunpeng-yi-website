---
import type { Copy } from "../data/i18n";
import { SITE } from "../data/site";
import { withBase } from "../lib/paths";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const cvHref = withBase(copy.lang === "zh" ? SITE.cvZh : SITE.cvEn);
---

<section class="hero" aria-labelledby="hero-name">
  <div class="wrap hero-grid">
    <div>
      <p class="kicker">{copy.hero.kicker}</p>
      <div class="hero-identity">
        <img
          class="hero-portrait"
          src={withBase(SITE.portrait)}
          alt={SITE.photoAlt}
          width="160"
          height="160"
          fetchpriority="high"
          decoding="async"
        />
        <div>
          <h1 id="hero-name">{copy.hero.name}</h1>
          <p class="hero-alt">{copy.hero.nameAlt}</p>
        </div>
      </div>
      <p class="hero-role">{copy.hero.role}</p>
      <p class="hero-aff">{copy.hero.affiliation}</p>
      <p class="hero-lab">
        <a href={SITE.labUrl} rel="noopener noreferrer">{copy.hero.lab}</a>
      </p>
      <p class="hero-lab-former">{copy.hero.labFormer}</p>
      <div class="hero-lines">
        {copy.hero.lines.map((line, index) => (
          <p class={index === 0 ? "hero-line" : "hero-core"}>{line}</p>
        ))}
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href={withBase(`${copy.homeHref}#research`)}>{copy.hero.explore}</a>
        <a class="btn btn-ghost" href={withBase(copy.publicationsHref)}>{copy.hero.publications}</a>
        <a class="btn btn-orange" href={cvHref} download>{copy.hero.cv}</a>
      </div>
    </div>
    <aside class="facts-card" aria-label={copy.hero.glanceTitle}>
      <h2 class="glance-title">{copy.hero.glanceTitle}</h2>
      <ul class="facts">
        {
          copy.hero.facts.map((fact) => (
            <li>
              <strong>{fact.value}</strong>
              <span>{fact.label}</span>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>
