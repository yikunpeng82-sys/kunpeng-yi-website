---
import type { Copy } from "../data/i18n";
import { SITE } from "../data/site";
import { withBase } from "../lib/paths";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="section" id={copy.about.id} aria-labelledby="about-title">
  <div class="wrap about-grid">
    <div>
      <p class="kicker" style="color: var(--wetland)">{copy.about.kicker}</p>
      <h2 id="about-title">{copy.about.title}</h2>
      <p><strong>{copy.about.lead}</strong></p>
      {copy.about.body.map((para) => <p>{para}</p>)}
      <p class="about-note">{copy.about.nameNote}</p>
      <p class="about-note">{copy.about.sourceNote}</p>
      <p class="about-note">{copy.about.labNote}</p>
    </div>
    <aside class="about-side">
      <figure class="about-photo">
        <img
          src={withBase(SITE.portrait)}
          alt={SITE.photoAlt}
          width="480"
          height="600"
          decoding="async"
        />
      </figure>
      <h3>{copy.about.timelineTitle}</h3>
      <ol class="timeline">
        {
          copy.about.timeline.map((item) => (
            <li>
              <strong>{item.role}</strong>
              <span>{item.place}</span>
            </li>
          ))
        }
      </ol>
    </aside>
  </div>
</section>
