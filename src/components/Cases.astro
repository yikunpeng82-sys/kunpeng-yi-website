---
import type { Copy } from "../data/i18n";
import { doiUrl } from "../data/publications";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="section band-sand" id={copy.featured.id} aria-labelledby="featured-title">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker" style="color: var(--wetland)">{copy.featured.kicker}</p>
      <h2 id="featured-title">{copy.featured.title}</h2>
      <p>{copy.featured.intro}</p>
    </div>
    <div class="featured-grid">
      {
        copy.featured.items.map((item) => (
          <article class="theme-card case-card">
            <figure class="case-figure" aria-label={copy.featured.placeholder}>
              <span class="case-figure-label">{item.figure}</span>
              <figcaption>{copy.featured.placeholder}</figcaption>
            </figure>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            {item.note ? <p class="program-note">{item.note}</p> : null}
            {
              item.doi ? (
                <p class="doi-line">
                  <a href={doiUrl(item.doi)} target="_blank" rel="noopener noreferrer">
                    DOI: {item.doi}
                  </a>
                </p>
              ) : null
            }
          </article>
        ))
      }
    </div>
  </div>
</section>
