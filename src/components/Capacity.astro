---
import type { Copy } from "../data/i18n";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="section" id={copy.tools.id} aria-labelledby="tools-title">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker" style="color: var(--wetland)">{copy.tools.kicker}</p>
      <h2 id="tools-title">{copy.tools.title}</h2>
      <p>{copy.tools.intro}</p>
    </div>
    <div class="featured-grid">
      {
        copy.tools.items.map((item) => (
          <article class="theme-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
    <p class="access-note">{copy.tools.access}</p>
  </div>
</section>
