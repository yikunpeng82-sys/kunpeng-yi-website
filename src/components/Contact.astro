---
import type { Copy } from "../data/i18n";
import { SITE } from "../data/site";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const address = copy.lang === "zh" ? SITE.addressZh : SITE.addressEn;
---

<section class="section" id={copy.contact.id} aria-labelledby="contact-title">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker" style="color: var(--wetland)">{copy.contact.kicker}</p>
      <h2 id="contact-title">{copy.contact.title}</h2>
      <p>{copy.contact.intro}</p>
    </div>
    <div class="contact-grid">
      <article class="contact-card">
        <h3 style="margin:0 0 0.4rem; color: var(--navy)">{copy.contact.email}</h3>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </article>
      <article class="contact-card">
        <h3 style="margin:0 0 0.4rem; color: var(--navy)">{copy.contact.phone}</h3>
        <a href={SITE.officePhoneHref}>{SITE.officePhone}</a>
      </article>
      <article class="contact-card">
        <h3 style="margin:0 0 0.4rem; color: var(--navy)">{copy.contact.address}</h3>
        <p>
          {address}
          <br />
          {copy.contact.postal} {SITE.postalCode}
        </p>
      </article>
      <article class="contact-card">
        <h3 style="margin:0 0 0.4rem; color: var(--navy)">{copy.contact.researchGate}</h3>
        <a href={SITE.researchGateUrl} rel="noopener noreferrer">researchgate.net/profile/Kunpeng-Yi</a>
      </article>
      <article class="contact-card">
        <h3 style="margin:0 0 0.4rem; color: var(--navy)">{copy.contact.scholar}</h3>
        <a href={SITE.scholarUrl} rel="noopener noreferrer">scholar.google.com</a>
      </article>
      <article class="contact-card">
        <h3 style="margin:0 0 0.4rem; color: var(--navy)">{copy.contact.cas}</h3>
        <a href={SITE.casUrl} rel="noopener noreferrer">rcees.cas.cn</a>
      </article>
      <article class="contact-card">
        <h3 style="margin:0 0 0.4rem; color: var(--navy)">{copy.contact.labProfile}</h3>
        <a href={SITE.labUrl} rel="noopener noreferrer">dse.rcees.cas.cn</a>
      </article>
      <article class="contact-card">
        <h3 style="margin:0 0 0.4rem; color: var(--navy)">{copy.contact.github}</h3>
        <a href={SITE.githubUrl} rel="noopener noreferrer">github.com/yikunpeng82-sys/kunpeng-yi-website</a>
      </article>
    </div>
  </div>
</section>
