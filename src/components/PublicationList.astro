---
import type { Copy } from "../data/i18n";
import {
  groupedByYear,
  doiUrl,
  FILTERS,
  FILTER_LABELS,
  isYi,
  displayAuthor,
  toBibTeX,
  allBibTeX,
} from "../data/publications";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const groups = groupedByYear();
const bibAll = allBibTeX();
---

<div>
  <div class="pub-toolbar">
    <div class="filters" role="group" aria-label={copy.pubs.filterLabel}>
      <button class="filter-btn" type="button" data-filter="all" aria-pressed="true">{copy.pubs.filterAll}</button>
      {
        FILTERS.map((id) => (
          <button class="filter-btn" type="button" data-filter={id} aria-pressed="false">
            {copy.pubs.filters[id]}
          </button>
        ))
      }
    </div>
    <button class="filter-btn" type="button" data-bib-all data-label={copy.pubs.bibtexAll} data-copied={copy.pubs.copied}>
      {copy.pubs.bibtexAll}
    </button>
    <textarea class="visually-hidden" data-bib-all-src readonly set:html={bibAll}></textarea>
  </div>
  <div class="pub-list" data-pub-list>
    {
      groups.map((group) => (
        <section class="year-group" data-year-group>
          <h2 class="year-heading">
            <span class="visually-hidden">{copy.pubs.yearHeading} </span>
            {group.year}
          </h2>
          {group.papers.map((paper) => (
            <article class="pub-card" data-filters={paper.filters.join(" ")}>
              <p class="cite">
                {paper.authors.map((name, i) => (
                  <>
                    {i > 0 ? ", " : ""}
                    {isYi(name) ? <strong>{displayAuthor(name, copy.lang)}</strong> : displayAuthor(name, copy.lang)}
                  </>
                ))}
                {" "}({paper.year}). {paper.title}. <em>{paper.journal}</em>
                {paper.volume ? ` ${paper.volume}` : ""}
                {paper.issue ? `(${paper.issue})` : ""}
                {paper.pages ? `: ${paper.pages}` : ""}.
              </p>
              <div class="tags">
                {paper.filters.map((id) => (
                  <span class="tag">{FILTER_LABELS[id][copy.lang]}</span>
                ))}
              </div>
              <p class="doi-line pub-links">
                {paper.doi ? (
                  <a href={doiUrl(paper.doi)} target="_blank" rel="noopener noreferrer">
                    {copy.pubs.doi}
                  </a>
                ) : null}
                {paper.pdfUrl ? (
                  <a href={paper.pdfUrl} target="_blank" rel="noopener noreferrer">
                    {copy.pubs.pdf}
                  </a>
                ) : null}
                {paper.codeUrl ? (
                  <a href={paper.codeUrl} target="_blank" rel="noopener noreferrer">
                    {copy.pubs.code}
                  </a>
                ) : null}
                {paper.dataUrl ? (
                  <a href={paper.dataUrl} target="_blank" rel="noopener noreferrer">
                    {copy.pubs.data}
                  </a>
                ) : null}
                {paper.projectUrl ? (
                  <a href={paper.projectUrl} target="_blank" rel="noopener noreferrer">
                    {copy.pubs.project}
                  </a>
                ) : null}
                <button
                  class="bib-btn"
                  type="button"
                  data-bib
                  data-label={copy.pubs.bibtex}
                  data-copied={copy.pubs.copied}
                >
                  {copy.pubs.bibtex}
                </button>
                <textarea class="visually-hidden" data-bib-src readonly set:html={toBibTeX(paper)}></textarea>
              </p>
            </article>
          ))}
        </section>
      ))
    }
  </div>
  <p class="about-note empty-state" data-empty hidden>{copy.pubs.empty}</p>
</div>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-btn[data-filter]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-pub-list] [data-filters]"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-year-group]"));
  const empty = document.querySelector<HTMLElement>("[data-empty]");

  function apply(filter: string) {
    let visible = 0;
    for (const card of cards) {
      const tags = (card.dataset.filters ?? "").split(/\s+/);
      const show = filter === "all" || tags.includes(filter);
      card.hidden = !show;
      if (show) visible += 1;
    }
    for (const group of groups) {
      const anyVisible = Array.from(group.querySelectorAll<HTMLElement>("[data-filters]")).some(
        (card) => !card.hidden,
      );
      group.hidden = !anyVisible;
    }
    if (empty) empty.hidden = visible > 0;
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.filter === filter));
    }
  }

  for (const button of buttons) {
    button.addEventListener("click", () => apply(button.dataset.filter ?? "all"));
  }

  async function copyText(source: HTMLTextAreaElement | null, button: HTMLButtonElement) {
    if (!source) return;
    const label = button.dataset.label ?? "BibTeX";
    const copied = button.dataset.copied ?? "Copied";
    try {
      await navigator.clipboard.writeText(source.value);
      button.textContent = copied;
      window.setTimeout(() => {
        button.textContent = label;
      }, 1600);
    } catch {
      source.hidden = false;
      source.focus();
      source.select();
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-bib]")) {
    button.addEventListener("click", () => {
      const source = button.parentElement?.querySelector<HTMLTextAreaElement>("[data-bib-src]") ?? null;
      void copyText(source, button);
    });
  }

  const allBtn = document.querySelector<HTMLButtonElement>("[data-bib-all]");
  const allSrc = document.querySelector<HTMLTextAreaElement>("[data-bib-all-src]");
  allBtn?.addEventListener("click", () => {
    void copyText(allSrc, allBtn);
  });
</script>
