---
import type { Copy } from "../data/i18n";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
---

<section class="section" id={copy.research.id} aria-labelledby="research-title">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker" style="color: var(--wetland)">{copy.research.kicker}</p>
      <h2 id="research-title">{copy.research.title}</h2>
      <p>{copy.research.intro}</p>
    </div>
    <div class="theme-grid">
      {
        copy.research.themes.map((theme) => (
          <article class="theme-card program-card">
            <h3>{theme.title}</h3>
            <div class="program-block">
              <h4>{copy.research.questionLabel}</h4>
              <p>{theme.question}</p>
            </div>
            <div class="program-block">
              <h4>{copy.research.methodsLabel}</h4>
              <p>{theme.methods}</p>
            </div>
            <div class="program-block">
              <h4>{copy.research.relevanceLabel}</h4>
              <p>{theme.relevance}</p>
            </div>
            {theme.note ? <p class="program-note">{theme.note}</p> : null}
          </article>
        ))
      }
    </div>
  </div>
</section>
