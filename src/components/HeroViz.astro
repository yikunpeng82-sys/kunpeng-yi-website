---
/**
 * Conceptual editorial illustration only.
 * Not a scientific map, not generated from observational rasters,
 * and not a substitute for published figures.
 */
---

<figure class="viz">
  <div class="viz-frame" aria-hidden="true">
    <svg viewBox="0 0 640 420" role="img" aria-labelledby="viz-title viz-desc">
      <title id="viz-title">Conceptual visualization of flyway, tracks, wetlands and energy landscape</title>
      <desc id="viz-desc">
        Stylized East Asian–Australasian Flyway outline with conceptual GPS tracks and stopovers,
        a wetland pixel grid, wind-turbine silhouettes and a white-naped crane silhouette.
        Labeled conceptual; not observational map data.
      </desc>
      <defs>
        <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0b1f33" />
          <stop offset="70%" stop-color="#123646" />
          <stop offset="100%" stop-color="#1c4a3c" />
        </linearGradient>
        <pattern id="pixels" width="14" height="14" patternUnits="userSpaceOnUse">
          <rect width="13" height="13" fill="#2a6b56" opacity="0.35" />
          <rect x="4" y="4" width="6" height="6" fill="#3aa89d" opacity="0.55" />
        </pattern>
      </defs>
      <rect width="640" height="420" fill="url(#sky)" />
      <text x="24" y="32" fill="#e6d7b8" font-size="12" font-weight="700" letter-spacing="1.4">
        CONCEPTUAL · 概念示意
      </text>

      <!-- Stylized EAAF corridor (not geodetic) -->
      <path
        class="eaaf"
        d="M430 36 C 470 90, 490 150, 470 200 S 400 300, 360 360"
        fill="none"
        stroke="#e6d7b8"
        stroke-width="18"
        stroke-linecap="round"
        opacity="0.16"
      />
      <path
        class="track"
        d="M418 52 C 452 100, 468 148, 452 198 S 392 292, 352 348"
        fill="none"
        stroke="#3aa89d"
        stroke-width="2.4"
        stroke-dasharray="7 8"
        stroke-linecap="round"
      />
      <path
        class="track track-b"
        d="M400 70 C 430 120, 438 170, 410 220 S 350 300, 330 350"
        fill="none"
        stroke="#e6d7b8"
        stroke-width="1.6"
        stroke-dasharray="3 9"
      />

      <!-- Stopovers -->
      <g fill="#d36b2e">
        <circle class="stop" cx="420" cy="78" r="5" />
        <circle class="stop" cx="456" cy="168" r="5" />
        <circle class="stop" cx="408" cy="248" r="5" />
        <circle class="stop" cx="356" cy="338" r="5" />
      </g>

      <!-- Wetland pixel block -->
      <g transform="translate(48 210)">
        <rect width="168" height="126" fill="url(#pixels)" rx="8" />
        <rect width="168" height="126" fill="none" stroke="#e6d7b8" stroke-opacity="0.35" rx="8" />
        <text x="10" y="18" fill="#e6d7b8" font-size="11">wetland pixels</text>
      </g>

      <!-- Turbine silhouettes -->
      <g class="turbines" fill="#e6d7b8" opacity="0.75" transform="translate(230 248)">
        <g>
          <rect x="18" y="42" width="3" height="58" />
          <path d="M19.5 42 L52 28 L22 48 Z" />
          <path d="M19.5 42 L2 8 L16 46 Z" />
          <path d="M19.5 42 L-8 62 L24 50 Z" />
        </g>
        <g transform="translate(52 18)">
          <rect x="18" y="42" width="3" height="46" />
          <path d="M19.5 42 L48 30 L22 48 Z" />
          <path d="M19.5 42 L6 12 L16 46 Z" />
          <path d="M19.5 42 L-4 64 L24 50 Z" />
        </g>
      </g>

      <!-- White-naped crane silhouette (stylized, not a field photo) -->
      <g class="crane" fill="#f6f1e6" transform="translate(470 250)">
        <path
          d="M12 78 C 28 70, 52 62, 70 48 C 82 40, 86 28, 78 22 C 90 18, 98 8, 92 2 C 86 10, 74 16, 64 22 C 48 18, 28 28, 18 42 C 8 56, 4 70, 12 78 Z"
        />
        <path d="M78 22 L104 8" stroke="#f6f1e6" stroke-width="2" fill="none" />
        <circle cx="94" cy="5" r="2.2" />
      </g>
    </svg>
  </div>
  <figcaption class="viz-caption">
    Conceptual visualization — East Asian–Australasian Flyway outline, GPS tracks and stopovers,
    wetland pixels, turbine silhouettes and a white-naped crane silhouette. Not observational map data.
  </figcaption>
</figure>

<style>
  .track {
    animation: dash 18s linear infinite;
  }

  .track-b {
    animation-duration: 26s;
  }

  .stop {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 3.6s ease-in-out infinite;
  }

  @keyframes dash {
    to {
      stroke-dashoffset: -240;
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .stop {
      animation: none;
    }
  }
</style>
