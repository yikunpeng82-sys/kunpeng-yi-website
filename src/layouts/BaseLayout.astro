---
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { SITE } from "../data/site";
import type { Copy } from "../data/i18n";
import { alternatePaths, withBase } from "../lib/paths";

interface Props {
  copy: Copy;
  title?: string;
  description?: string;
  canonicalPath: string;
  jsonLd?: Record<string, unknown>;
}

const { copy, title, description, canonicalPath, jsonLd } = Astro.props;
const pageTitle = title ?? copy.meta.title;
const pageDescription = description ?? copy.meta.description;
const origin = Astro.site ?? new URL("https://yikunpeng82-sys.github.io");
const canonical = new URL(withBase(canonicalPath), origin).href;
const alternates = alternatePaths(canonicalPath);
const alternateEn = new URL(withBase(alternates.en), origin).href;
const alternateZh = new URL(withBase(alternates.zh), origin).href;

const ogJpgOnDisk = existsSync(join(process.cwd(), "public/images/og-kunpeng-yi.jpg"));
const ogPath = ogJpgOnDisk ? SITE.ogImage : SITE.ogFallback;
const ogImage = new URL(withBase(ogPath), origin).href;
const portraitUrl = new URL(withBase(SITE.portrait), origin).href;
const ogType = ogJpgOnDisk ? "image/jpeg" : "image/png";

const personLd = jsonLd ?? {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.nameEn,
  alternateName: [SITE.nameZh, SITE.nameEnPage],
  jobTitle: SITE.titleEn,
  email: `mailto:${SITE.email}`,
  telephone: SITE.officePhone,
  url: canonical,
  image: portraitUrl,
  affiliation: {
    "@type": "Organization",
    name: SITE.orgEn,
    department: `${SITE.labEn} (${SITE.labEnShort})`,
    url: SITE.labUrl,
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.addressEn,
    postalCode: SITE.postalCode,
    addressCountry: "CN",
  },
  sameAs: [
    SITE.scholarUrl,
    SITE.researchGateUrl,
    SITE.casUrl,
    SITE.labUrl,
    SITE.ucasUrl,
    SITE.githubUrl,
  ],
};
---

<!doctype html>
<html lang={copy.htmlLang} dir={copy.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={`${SITE.nameEn} / ${SITE.nameZh}`} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="zh-CN" href={alternateZh} />
    <link rel="alternate" hreflang="x-default" href={alternateEn} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={copy.meta.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={SITE.photoAlt} />
    <meta property="og:image:type" content={ogType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE.photoAlt} />
    <meta name="theme-color" content="#0b1f33" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <a class="skip-link" href="#content">{copy.skip}</a>
    <Header copy={copy} />
    <main id="content">
      <slot />
    </main>
    <Footer copy={copy} />
  </body>
</html>
