---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCopy } from "../../../data/i18n";
import { withBase } from "../../../lib/paths";

const copy = getCopy("zh");
---

<BaseLayout
  copy={copy}
  canonicalPath="/zh/cv/"
  title={`${copy.cvPage.title} · 易昆鹏`}
  description={copy.cvPage.body}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker" style="color: var(--wetland)">简历</p>
      <h1>{copy.cvPage.title}</h1>
      <p>{copy.cvPage.body}</p>
      <p>
        <a class="btn btn-primary" href={withBase("/cv/kunpeng-yi-cv-placeholder.pdf")} download>
          {copy.hero.cv}
        </a>
      </p>
      <p><a href={withBase("/zh/")}>{copy.cvPage.back}</a></p>
    </div>
  </section>
</BaseLayout>
