---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCopy } from "../../../data/i18n";
import { CV_FILES, CV_HOSTED_PROJECTS } from "../../../data/cv";
import { withBase } from "../../../lib/paths";

const copy = getCopy("zh");
---

<BaseLayout
  copy={copy}
  canonicalPath="/zh/cv/"
  title={`${copy.cvPage.title} · 易昆鹏`}
  description={copy.cvPage.body}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker" style="color: var(--wetland)">简历</p>
      <h1>{copy.cvPage.title}</h1>
      <p>{copy.cvPage.body}</p>
      <p class="chooser-label">{copy.cvPage.chooserLabel}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={withBase(CV_FILES.zhPdf)} download>{copy.cvPage.downloadZh}</a>
        <a class="btn btn-ghost" href={withBase(CV_FILES.enPdf)} download>{copy.cvPage.downloadEn}</a>
      </div>
      <p class="about-note">{copy.cvPage.privacy}</p>
      <h2 class="cv-heading">{copy.about.timelineTitle}</h2>
      <ol class="timeline">
        {
          copy.about.timeline.map((item) => (
            <li>
              <strong>{item.role}</strong>
              <span>{item.place}</span>
            </li>
          ))
        }
      </ol>
      <h2 class="cv-heading">{copy.cvPage.projectsTitle}</h2>
      <p>{copy.cvPage.projectsIntro}</p>
      <ol class="timeline">
        {
          CV_HOSTED_PROJECTS.zh.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.source} · {item.dates} · {item.role}</span>
            </li>
          ))
        }
      </ol>
      <p><a href={withBase("/zh/")}>{copy.cvPage.back}</a></p>
    </div>
  </section>
</BaseLayout>
