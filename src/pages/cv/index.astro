---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCopy } from "../../data/i18n";
import { CV_FILES, CV_HOSTED_PROJECTS } from "../../data/cv";
import { withBase } from "../../lib/paths";

const copy = getCopy("en");
---

<BaseLayout
  copy={copy}
  canonicalPath="/cv/"
  title={`${copy.cvPage.title} · Kunpeng Yi`}
  description={copy.cvPage.body}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker" style="color: var(--wetland)">CV</p>
      <h1>{copy.cvPage.title}</h1>
      <p>{copy.cvPage.body}</p>
      <p class="chooser-label">{copy.cvPage.chooserLabel}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={withBase(CV_FILES.enPdf)} download>{copy.cvPage.downloadCvEn}</a>
        <a class="btn btn-ghost" href={withBase(CV_FILES.zhPdf)} download>{copy.cvPage.downloadCvZh}</a>
        <a class="btn btn-ghost" href={withBase(CV_FILES.enBio)} download>{copy.cvPage.downloadBioEn}</a>
        <a class="btn btn-ghost" href={withBase(CV_FILES.zhBio)} download>{copy.cvPage.downloadBioZh}</a>
      </div>
      <h2 class="cv-heading">{copy.about.timelineTitle}</h2>
      <ol class="timeline">
        {
          copy.about.timeline.map((item) => (
            <li>
              <strong>{item.role}</strong>
              <span>{item.place}</span>
            </li>
          ))
        }
      </ol>
      <h2 class="cv-heading">{copy.cvPage.projectsTitle}</h2>
      <p>{copy.cvPage.projectsIntro}</p>
      <ol class="timeline">
        {
          CV_HOSTED_PROJECTS.en.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.source} · {item.dates} · {item.role}</span>
            </li>
          ))
        }
      </ol>
      <p><a href={withBase("/")}>{copy.cvPage.back}</a></p>
    </div>
  </section>
</BaseLayout>
