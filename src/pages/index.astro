---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Research from "../components/Research.astro";
import Cases from "../components/Cases.astro";
import Capacity from "../components/Capacity.astro";
import SelectedWork from "../components/SelectedWork.astro";
import Collaborate from "../components/Collaborate.astro";
import Contact from "../components/Contact.astro";
import { getCopy } from "../data/i18n";

const copy = getCopy("en");
---

<BaseLayout copy={copy} canonicalPath="/">
  <Hero copy={copy} />
  <Research copy={copy} />
  <Cases copy={copy} />
  <Capacity copy={copy} />
  <SelectedWork copy={copy} />
  <Collaborate copy={copy} />
  <Contact copy={copy} />
</BaseLayout>
